import os
from google import genai
import customtkinter as ctk
from gtts import gTTS
import speech_recognition as sr

# Arayüz tema ayarları
ctk.set_appearance_mode("Dark")
ctk.set_default_color_theme("blue")


class NexonApp(ctk.CTk):

    def __init__(self):
        super().__init__()

        self.title("NexonGPT (Sesli & Konuşan Asistan)")
        self.geometry("400x700")
        self.resizable(False, False)

        # Gemini Client ve Hafıza (Chat Oturumu) Başlatma
        self.client = genai.Client(
            api_key="AQ.Ab8RN6Ka8EjTv9amd72YYjFNxX2tFUNQAu9vOdZZ5vnzFsSm0g"
        )
        self.chat_session = self.client.chats.create(model="gemini-2.5-flash")

        # Sohbet Geçmişi Ekranı (TextBox)
        self.chat_box = ctk.CTkTextbox(
            self, width=370, height=500, corner_radius=10
        )
        self.chat_box.pack(pady=15, padx=15)
        self.chat_box.insert(
            "end", "🤖 NexonGPT Sesli Asistan Hazır...\n\n"
        )
        self.chat_box.configure(state="disabled")

        # Alt Mesaj Yazma Paneli
        self.input_frame = ctk.CTkFrame(self, fg_color="transparent")
        self.input_frame.pack(pady=5, padx=15, fill="x")

        self.user_input = ctk.CTkEntry(
            self.input_frame, placeholder_text="Mesajınızı yazın...", width=200
        )
        self.user_input.pack(side="left", padx=(0, 5))
        self.user_input.bind("<Return>", self.send_message)

        self.send_button = ctk.CTkButton(
            self.input_frame, text="Gönder", width=75, command=self.send_message
        )
        self.send_button.pack(side="left", padx=(0, 5))

        # Mikrofonla Sesli Komut Gönderme Butonu
        self.mic_button = ctk.CTkButton(
            self.input_frame,
            text="🎤 Dinle",
            width=75,
            fg_color="#D32F2F",
            hover_color="#B71C1C",
            command=self.listen_voice,
        )
        self.mic_button.pack(side="right")

    def sesli_okut(self, metin):
        """Asistanın verdiği metni Türkçeye çevirip sesli okuyan fonksiyon"""
        try:
            tts = gTTS(text=metin, lang="tr", slow=False)
            tts.save("nexonses.mp3")
            os.system("start nexonses.mp3")
        except Exception as e:
            print(f"Seslendirme hatası: {e}")

    def listen_voice(self):
        """Mikrofonu dinler ve söylenenleri Türkçe olarak yazıya çevirir"""
        recognizer = sr.Recognizer()
        
        # Kullanıcıya dinlendiğini hissettirmek için arayüze bilgi yazalım
        self.chat_box.configure(state="normal")
        self.chat_box.insert("end", "🎤 Dinleniyor, lütfen konuşun...\n")
        self.chat_box.configure(state="disabled")
        self.chat_box.see("end")
        self.update()

        try:
            with sr.Microphone() as source:
                recognizer.adjust_for_ambient_noise(source, duration=0.5)
                audio = recognizer.listen(source, timeout=5, phrase_time_limit=10)
                
                # Google Speech Recognition kullanarak sesi Türkçeye çevir
                text = recognizer.recognize_google(audio, language="tr-TR")
                
                # Algılanan metni giriş kutusuna yazdır ve direkt gönder
                self.user_input.delete(0, "end")
                self.user_input.insert(0, text)
                self.send_message()
                
        except sr.WaitTimeoutError:
            self.update_chat("NexonGPT: Ses algılanamadı (Zaman aşımı).\n\n")
        except sr.UnknownValueError:
            self.update_chat("NexonGPT: Söylediklerinizi anlayamadım, lütfen tekrar deneyin.\n\n")
        except Exception as e:
            self.update_chat(f"NexonGPT: Mikrofon Hatası -> {e}\n\n")

    def update_chat(self, message):
        """Hata veya durum mesajlarını ekrana yazdırmak için yardımcı fonksiyon"""
        self.chat_box.configure(state="normal")
        self.chat_box.insert("end", message)
        self.chat_box.configure(state="disabled")
        self.chat_box.see("end")

    def send_message(self, event=None):
        user_text = self.user_input.get().strip()
        if not user_text:
            return

        # Kullanıcı mesajını ekrana yazdır
        self.chat_box.configure(state="normal")
        self.chat_box.insert("end", f"Siz: {user_text}\n")
        self.user_input.delete(0, "end")
        self.chat_box.configure(state="disabled")
        self.chat_box.see("end")

        # Gemini'ye gönder ve hafızayı yönet
        try:
            response = self.chat_session.send_message(user_text)
            bot_reply = response.text
            
            self.chat_box.configure(state="normal")
            self.chat_box.insert("end", f"NexonGPT: {bot_reply}\n\n")
            self.chat_box.configure(state="disabled")
            self.chat_box.see("end")

            # Botun cevabını sesli okut
            self.sesli_okut(bot_reply)

        except Exception as e:
            self.chat_box.configure(state="normal")
            self.chat_box.insert("end", f"NexonGPT: Hata -> {e}\n\n")
            self.chat_box.configure(state="disabled")
            self.chat_box.see("end")


if __name__ == "__main__":
    app = NexonApp()
    app.mainloop()